class ListNode:
    def __init__(self, val, next=None):
        self.val= val
        self.next=next
    
    def __repr__(self):
        vals=[]
        curr=self
        while curr:
            vals.append(str(curr.val))
            curr= curr.next
        return "->".join(vals)
        
class Solution:
    def find_cycle_start(self, head):
        slow= fast= head
        while fast and fast.next:
            slow= slow.next
            fast= fast.next.next
            if slow==fast:
                break
        else:
            return None
        
        slow= head
        while slow!=fast:
            slow=slow.next
            fast= fast.next
        return slow
        
