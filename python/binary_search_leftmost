from collections import defaultdict, Counter
class Solution:
    def binary_search_leftmost(self, arr,t):
        left, right=0, len(arr)-1
        while(left<=right):
            mid= (left+right)//2
            if arr[mid]<t:
                left=mid+1
            else:
                right=mid-1
        return left
        
s= Solution()
print(s.binary_search_leftmost([1,1,2,6,6,6,8,9,10,11,11,16,20,23,23,40],6))
