class ListNode:
    def __init__(self, val, next=None):
        self.val= val
        self.next=next
    
    def __repr__(self):
        vals=[]
        curr=self
        while curr:
            vals.append(str(curr.val))
            curr= curr.next
        return "->".join(vals)
        
class Solution:
    def has_cycle(self, head):
        slow= head
        fast= head
        while fast and fast.next:
            slow= slow.next
            fast= fast.next.next
            if slow==fast:
                return True
        return False
        
s=Solution()
n1= ListNode(1)
