from collections import defaultdict, deque
graph= defaultdict(list)

def build_adjacency_list(edges, ditected=False):
    for u,v in edges:
        graph[u].append(v)
        if not ditected:
            graph[v].append(u)
    return graph

def has_cycle_directed(n):
    WHITE, GREY, BLACK= 0,1,2
    color= {i: WHITE for i in range(n)}
    def dfs(node):
        color[node]= GREY
        for nbr in graph[node]:
            if color[nbr]==GREY:
                return True
            if color[nbr]==WHITE and dfs(nbr):
                return True
        color[node]= BLACK
        return False
    for node in range(n):
        if color[node]== WHITE and dfs(node):
            return True
    return False

build_adjacency_list([[2,3],[3,1],[3,5],[5,6]])
print(has_cycle_directed(5))
