from collections import defaultdict, deque
graph= defaultdict(list)

def topological_sort(n, edges):
    indegree= [0]*n
    graph= defaultdict(list)
    queue= deque()
    res=[]
    for u,v in edges:
        graph[u].append(v)
        indegree[v]+=1
    
    for i in range(n):
        if indegree[i]==0:
            queue.append(i)
    
    while queue:
        index= queue.popleft()
        res.append(index)
        for nbr in graph[index]:
            indegree[nbr]-=1
            if indegree[nbr]==0:
                queue.append(nbr)
    
    return res if len(res)==n else []


edges= [[2,3],[3,1],[3,5],[5,6]]
print(topological_sort(7,edges))
