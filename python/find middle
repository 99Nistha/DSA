class ListNode:
    def __init__(self, val, next=None):
        self.val= val
        self.next=next
    
    def __repr__(self):
        vals=[]
        curr=self
        while curr:
            vals.append(str(curr.val))
            curr= curr.next
        return "->".join(vals)
        
class Solution:
    def middle(self, node):
        slow=fast=node
        while fast and fast.next:
            slow= slow.next
            fast= fast.next.next
        return slow

s=Solution()
l1= ListNode(1, ListNode(12, ListNode(3, ListNode(14, ListNode(2)))))
print(s.middle(l1).val)
