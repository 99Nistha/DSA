class Solution:
    def remove_duplicates_sorted(self, arr):
        if not arr:
            return 0
        if len(arr)<=1:
            return len(arr)
        index=1
        prev= arr[0]
        for i in range(1,len(arr)):
            if arr[i]!=prev:
               index+=1
            prev= arr[i]
        return index
    
s= Solution()
print(s.remove_duplicates_sorted([2,3,3,4,5,6]))
